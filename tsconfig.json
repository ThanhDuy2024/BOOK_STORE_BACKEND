{
  "compilerOptions": {
    "target": "ES6",
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "esModuleInterop": true,
    "resolveJsonModule": true,

    "strict": true,

    "rootDir": "./",
    "outDir": "./dist",

    "skipLibCheck": true
  },

  "include": ["src", "**/*.ts"],
  "exclude": ["node_modules", "dist"]
}